---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogGrid from '../../components/blog/BlogGrid.astro';
import { PAGE_SIZE } from '../../config/pagination';

const allPosts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const posts = allPosts.slice(0, PAGE_SIZE);

const currentPage = 1;
const prevUrl = null;
const nextUrl = totalPages > 1 ? '/blog/page/2' : null;
---

<BaseLayout title="博客" description="所有博客文章列表">
    <section class="relative mx-auto max-w-5xl px-4 py-14 sm:py-16">
        <h1 class="mb-3 flex items-center gap-3 text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl">
            <span aria-hidden="true" class="inline-block h-6 w-[3px] rounded-full bg-brand-500 sm:h-8"></span>
            博客
        </h1>
        <p class="mb-10 font-mono text-sm text-[var(--fg-muted)]">
            共 {allPosts.length} 篇文章
        </p>

        <BlogGrid
                posts={posts}
                currentPage={currentPage}
                totalPages={totalPages}
                prevUrl={prevUrl}
                nextUrl={nextUrl}
                basePath="/blog"
        />
    </section>
</BaseLayout>