//This is /src/pages/index.astro
---
import Footer from '../components/index-react/Footer.astro';
import StarGazing from '../components/index-react/StarGazing.tsx';
import DynamicSchedule from '../components/index-react/DynamicSchedule.tsx';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>e2147dev</title>
    <script is:inline>
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="min-h-screen flex flex-col bg-[#F4F1EA] dark:bg-[#1A1A1A] text-[#1A1A1A] dark:text-[#F4F1EA] transition-colors duration-500 overflow-x-hidden">

<!-- 右上角主题切换按钮 -->
<button id="theme-toggle" class="fixed top-6 right-6 z-50 p-2.5 rounded-full bg-gray-200/80 dark:bg-gray-800/80 backdrop-blur-md shadow-lg hover:scale-110 hover:bg-gray-300 dark:hover:bg-gray-700 transition-all duration-300" aria-label="切换主题">
    <svg id="theme-icon-light" class="w-5 h-5 hidden dark:block text-yellow-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    <svg id="theme-icon-dark" class="w-5 h-5 block dark:hidden text-gray-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<!-- 第一屏：Hero -->
<section class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative">
    <h1 class="text-6xl md:text-8xl font-bold tracking-tight text-[#1A1A1A] dark:text-[#F4F1EA] transition-colors duration-500">e2147dev</h1>
    <p class="mt-6 text-xl md:text-2xl text-gray-500 dark:text-gray-400 font-light tracking-widest transition-colors duration-500">学最好的别人，做最好的自己</p>
</section>

<!-- 第二屏：课程表（React 组件，必须加 client:load） -->
<section class="min-h-screen flex items-center justify-center px-4 py-20 bg-white/40 dark:bg-black/20 transition-colors duration-500">
    <DynamicSchedule client:load />
</section>

<!-- 入口导航：三个按钮 -->
<section class="flex items-center justify-center px-6 py-24 md:py-32">
    <div class="grid w-full max-w-4xl grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">

        <!-- 小游戏 -->
        <a href="/2048"
           class="group flex flex-col items-center justify-center gap-4 rounded-2xl border border-[#1A1A1A]/10 dark:border-[#F4F1EA]/10 bg-white/40 dark:bg-black/20 backdrop-blur-md px-6 py-10 text-center shadow-lg shadow-black/5 dark:shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:border-[#1A1A1A]/25 dark:hover:border-[#F4F1EA]/25 hover:bg-white/70 dark:hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1A1A1A]/40 dark:focus-visible:ring-[#F4F1EA]/40">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-200/80 dark:bg-gray-800/80 text-[#1A1A1A] dark:text-[#F4F1EA] transition-all duration-300 group-hover:scale-110 group-hover:bg-[#1A1A1A] group-hover:text-[#F4F1EA] dark:group-hover:bg-[#F4F1EA] dark:group-hover:text-[#1A1A1A]">
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            </span>
            <span class="text-lg font-light tracking-widest">小游戏</span>
            <span class="text-xs tracking-[0.2em] text-gray-500 dark:text-gray-400 transition-colors duration-500">2048</span>
        </a>

        <!-- 博客 -->
        <a href="/blog"
           class="group flex flex-col items-center justify-center gap-4 rounded-2xl border border-[#1A1A1A]/10 dark:border-[#F4F1EA]/10 bg-white/40 dark:bg-black/20 backdrop-blur-md px-6 py-10 text-center shadow-lg shadow-black/5 dark:shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:border-[#1A1A1A]/25 dark:hover:border-[#F4F1EA]/25 hover:bg-white/70 dark:hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1A1A1A]/40 dark:focus-visible:ring-[#F4F1EA]/40">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-200/80 dark:bg-gray-800/80 text-[#1A1A1A] dark:text-[#F4F1EA] transition-all duration-300 group-hover:scale-110 group-hover:bg-[#1A1A1A] group-hover:text-[#F4F1EA] dark:group-hover:bg-[#F4F1EA] dark:group-hover:text-[#1A1A1A]">
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
            </span>
            <span class="text-lg font-light tracking-widest">博客</span>
            <span class="text-xs tracking-[0.2em] text-gray-500 dark:text-gray-400 transition-colors duration-500">BLOG</span>
        </a>

        <!-- 关于 -->
        <a href="/about"
           class="group flex flex-col items-center justify-center gap-4 rounded-2xl border border-[#1A1A1A]/10 dark:border-[#F4F1EA]/10 bg-white/40 dark:bg-black/20 backdrop-blur-md px-6 py-10 text-center shadow-lg shadow-black/5 dark:shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:border-[#1A1A1A]/25 dark:hover:border-[#F4F1EA]/25 hover:bg-white/70 dark:hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1A1A1A]/40 dark:focus-visible:ring-[#F4F1EA]/40">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-200/80 dark:bg-gray-800/80 text-[#1A1A1A] dark:text-[#F4F1EA] transition-all duration-300 group-hover:scale-110 group-hover:bg-[#1A1A1A] group-hover:text-[#F4F1EA] dark:group-hover:bg-[#F4F1EA] dark:group-hover:text-[#1A1A1A]">
                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            </span>
            <span class="text-lg font-light tracking-widest">关于</span>
            <span class="text-xs tracking-[0.2em] text-gray-500 dark:text-gray-400 transition-colors duration-500">ABOUT</span>
        </a>

    </div>
</section>

<!-- 第三屏：星空（React 组件，必须加 client:load） -->
<section class="h-screen w-full relative">
    <StarGazing client:load />
</section>

<!-- 页脚 -->
<Footer />

<!-- 主题切换逻辑 -->
<script is:inline>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle.addEventListener('click', () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        }
    });
</script>
</body>
</html>