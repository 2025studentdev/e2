---
import Footer from '../components/index-react/Footer.astro';
import StarGazing from '../components/index-react/StarGazing.tsx';
import DynamicSchedule from '../components/index-react/DynamicSchedule.tsx';
import '../styles/global.css';
import '../components/index-react/index1.css';

// ===== 入口数据：加一项只需要加一行 =====
const links = [
    {
        href: '/games',
        zh: '小游戏',
        en: 'GAMES',
        desc: '把想法做成能玩的东西。这里放着我用碎片时间拼出来的小实验，欢迎试玩',
        icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    },
    {
        href: '/blog',
        zh: '博客',
        en: 'BLOG',
        desc: '把踩过的坑、读过的源码、想明白的事，一条条写下来。',
        icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>',
    },
    {
        href: '/docs',
        zh: '文档',
        en: 'DOCS',
        desc: '笔记与速查手册。',
        icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
    },
    {
        href: '/about',
        zh: '关于',
        en: 'ABOUT',
        desc: '这里是谁、在做什么、以及怎么找到我。如果你也想聊聊技术以外的事——比如最近在读什么书、听了什么歌，这里是最好的入口。',
        icon: '<circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/>',
    },
];

// ===== 语录：三条执念 =====
const quotes = [
    {
        index: '01',
        text: '学最好的别人，做最好的自己。',
        note: '所以，先抄，再改，最后扔掉。别人的解法只是起点，终点得自己走。',
    },
    {
        index: '02',
        text: '慢一点，做透一点。',
        note: '比起铺开十件事，不如把一件做到能在深夜里安心睡着。',
    },
    {
        index: '03',
        text: '把复杂拆开，把简单做好。',
        note: '大部分难题，都是几个简单问题的串联。拆得越细，越不容易迷路。',
    },
];

const pageTitle = 'E2147dev';
const pageDesc = '学最好的别人，做最好的自己';
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth no-js">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/doge.png" />

    <meta name="theme-color" content="#0F0F12" />

    <!-- SEO -->
    <meta name="description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 标记 JS 可用，避免禁用 JS 时整页空白 -->
    <script is:inline>
        document.documentElement.classList.remove('no-js');
        document.documentElement.classList.add('js');
    </script>
</head>
<body class="grid-bg min-h-dvh flex flex-col overflow-x-hidden text-[#EDEAE3] antialiased">

<!-- ============ 1. 首屏：黑白斜切 ============ -->
<section class="hero">
    <div class="hero__slash" aria-hidden="true"></div>
    <div class="hero__content">
        <h1 class="hero__title">{pageTitle}</h1>
        <p class="hero__sub">{pageDesc}</p>
    </div>
</section>

<!-- ============ 2. 介绍 ============ -->
<section class="section intro">
    <div class="wrap">
        <p class="eyebrow" data-reveal>Introduction · 这里是什么</p>
        <p class="intro__lead" data-reveal style="--reveal-delay: 100ms">
            一个写代码的人，一些没写完的想法，一处被访问到的角落。
        </p>
        <p class="intro__body" data-reveal style="--reveal-delay: 220ms">
            不止是完成任务，更是解决问题.
            不满足于做完，执着于做好.
        </p>
    </div>
</section>

<!-- ============ 3. 课程表（在星空上方） ============ -->
<section class="section" id="schedule">
    <div class="wrap">
        <p class="eyebrow" data-reveal>Now · 这周在忙什么</p>
        <h2 class="section__title" data-reveal style="--reveal-delay: 100ms">本周日程</h2>
        <p class="section__lead" data-reveal style="--reveal-delay: 200ms">
            这张表每天都会变。它记录着我此刻的时间被切成什么形状——
        </p>
        <div class="mt-16" data-reveal style="--reveal-delay: 300ms">
            <DynamicSchedule client:visible />
        </div>
    </div>
</section>

<!-- ============ 4. 四个入口 ============ -->
<section class="section" id="entries">
    <div class="wrap">
        <p class="eyebrow" data-reveal>Explore · 从这里开始</p>
        <h2 class="section__title" data-reveal style="--reveal-delay: 100ms">四个入口</h2>
        <p class="section__lead" data-reveal style="--reveal-delay: 200ms">
            站点不大，但每一个角落都被认真对待过。挑一个你感兴趣的，慢慢逛。
        </p>

        <div class="entries">
            {links.map(({ href, zh, en, desc, icon }, i) => (
                    <div class="entry" data-reveal style={`--reveal-delay: ${i * 120}ms`}>
                        <a href={href} class="entry__btn">
                        <span class="entry__icon">
                            <svg
                                    class="w-5 h-5"
                                    aria-hidden="true"
                                    focusable="false"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    set:html={icon}
                            />
                        </span>
                            <span class="entry__labels">
                            <span class="entry__zh">{zh}</span>
                            <span class="entry__en">{en}</span>
                        </span>
                        </a>
                        <p class="entry__desc">{desc}</p>
                    </div>
            ))}
        </div>
    </div>
</section>

<!-- ============ 5. 语录 ============ -->
<section class="section" id="quotes">
    <div class="wrap">
        <p class="eyebrow" data-reveal>Principles · 一点执念</p>
        <h2 class="section__title" data-reveal style="--reveal-delay: 100ms">写给自己的三句话</h2>
        <p class="section__lead" data-reveal style="--reveal-delay: 200ms">
            它们被我贴在显示器边上，也贴在每一次提交之前。
        </p>

        <div class="quotes">
            {quotes.map(({ index, text, note }, i) => (
                    <blockquote class="quote" data-reveal style={`--reveal-delay: ${i * 140}ms`}>
                        <span class="quote__index">/ {index}</span>
                        <p class="quote__text">{text}</p>
                        <p class="quote__note">{note}</p>
                    </blockquote>
            ))}
        </div>
    </div>
</section>

<!-- ============ 6. 星空 ============ -->
<section class="section--star" id="star">
    <div class="star__intro">
        <p class="eyebrow" data-reveal>Night · 抬头看看</p>
        <h2 class="section__title" data-reveal style="--reveal-delay: 100ms">这片星空，属于你</h2>
        <p class="section__lead" data-reveal style="--reveal-delay: 200ms">
            白天的屏幕看久了，抬头看看。
        </p>
    </div>
    <div class="star__stage">
        <StarGazing client:idle />
    </div>
</section>

<Footer />

<script is:inline>
    // 滚动显现：元素进入视口后加 is-visible，并只触发一次
    const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
            if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
            }
        }
    }, { threshold: 0.14, rootMargin: '0px 0px -6% 0px' });

    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

</body>
</html>