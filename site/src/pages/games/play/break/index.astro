---
// D:\WebProj\e2\site\src\pages\games\play\break\index.astro
import Breakout from './_Breakout';
---

<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#eceef3" />
    <title>BREAKOUT — 打砖块</title>
</head>
<body>
<Breakout client:only="react" />
</body>
</html>

<style is:global>
    :root {
        color-scheme: light;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px 20px;
        background: #eceef3;
        color: #1e293b;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
        'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .brk-shell {
        width: min(920px, 100%);
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* ---------------- 顶部信息 ---------------- */
    .brk-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 0 2px;
    }

    .brk-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brk-mark {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: #1e293b;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 2.5px;
        padding: 5.5px;
    }

    .brk-mark i {
        display: block;
        border-radius: 1.5px;
        background: #38bdf8;
    }

    .brk-mark i:nth-child(2) {
        background: #f2b23e;
    }
    .brk-mark i:nth-child(3) {
        background: #f0788a;
    }
    .brk-mark i:nth-child(4) {
        background: #3fbfa8;
    }

    .brk-title {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #64748b;
    }

    .brk-stats {
        display: flex;
        align-items: flex-end;
        gap: 28px;
    }

    .brk-stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .brk-stat-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #a3adbe;
    }

    .brk-stat-value {
        font-size: 22px;
        font-weight: 700;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: #1e293b;
    }

    .brk-lives {
        display: flex;
        gap: 5px;
        padding-bottom: 5px;
    }

    .brk-life {
        width: 11px;
        height: 11px;
        border-radius: 3px;
        background: #1e293b;
        transition: background 0.25s ease;
    }

    .brk-life--off {
        background: #d5dbe5;
    }

    /* ---------------- 舞台 ---------------- */
    .brk-stage {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 2;
        border-radius: 22px;
        background: #f7f9fc;
        box-shadow: 0 0 0 1px rgba(30, 41, 59, 0.07), 0 24px 48px -28px rgba(30, 41, 59, 0.35),
        0 2px 6px rgba(30, 41, 59, 0.04);
        overflow: hidden;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        cursor: crosshair;
    }

    .brk-canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    /* ---------------- 遮罩层 ---------------- */
    .brk-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 24px;
        text-align: center;
        background: rgba(247, 249, 252, 0.84);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        pointer-events: none;
        animation: brk-fade 0.22s ease;
    }

    @keyframes brk-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .brk-overlay-tag {
        margin: 0;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #3b82f6;
    }

    .brk-overlay-title {
        margin: 0;
        font-size: clamp(22px, 3.4vw, 32px);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #1e293b;
    }

    .brk-overlay-desc {
        margin: 0;
        font-size: 13px;
        color: #94a3b8;
    }

    .brk-btn {
        margin-top: 10px;
        pointer-events: auto;
        border: 0;
        border-radius: 11px;
        padding: 12px 28px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #f8fafc;
        background: #1e293b;
        cursor: pointer;
        transition: background 0.16s ease, transform 0.12s ease;
    }

    .brk-btn:hover {
        background: #334155;
    }

    .brk-btn:active {
        transform: scale(0.97);
    }

    /* ---------------- 底部 ---------------- */
    .brk-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 0 2px;
        font-size: 12px;
        color: #a3adbe;
    }

    .brk-keys {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    kbd {
        display: inline-block;
        min-width: 22px;
        padding: 3px 7px;
        border-radius: 6px;
        background: #fff;
        color: #475569;
        font-family: inherit;
        font-size: 11px;
        font-weight: 600;
        text-align: center;
        box-shadow: 0 0 0 1px rgba(30, 41, 59, 0.08), 0 1px 2px rgba(30, 41, 59, 0.06);
    }

    .brk-icon-btn {
        border: 0;
        padding: 7px 14px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        background: #fff;
        box-shadow: 0 0 0 1px rgba(30, 41, 59, 0.08);
        cursor: pointer;
        transition: color 0.15s ease, box-shadow 0.15s ease;
    }

    .brk-icon-btn:hover {
        color: #1e293b;
        box-shadow: 0 0 0 1px rgba(30, 41, 59, 0.18);
    }

    @media (max-width: 640px) {
        body {
            padding: 16px 12px;
        }
        .brk-stats {
            gap: 16px;
        }
        .brk-stat-value {
            font-size: 18px;
        }
        .brk-stat:last-child {
            display: none;
        }
    }
</style>