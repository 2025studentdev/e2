---
import Footer from '../../components/index-react/Footer.astro';
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>文档 · e2147dev</title>
    <link rel="icon" type="image/png" href="/doge.png" />
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden bg-[#F4F1EA]">

<main class="flex-1 flex flex-col items-center justify-center text-center px-4">

    <span class="mb-6 text-[10px] font-medium tracking-[0.4em] text-[#1A1A1A]/40">
        DOCS
    </span>

    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-[#1A1A1A]">
        文档页面开发中
    </h1>

    <p class="mt-6 text-base md:text-lg text-[#1A1A1A]/55 font-light tracking-widest">
        敬请期待
    </p>

    <a href="/"
       class="mt-12 inline-flex items-center gap-2 rounded-full border border-[#1A1A1A]/15 bg-white/70 px-6 py-2.5 text-sm font-light tracking-widest text-[#1A1A1A]/75 shadow-[0_8px_32px_-12px_rgba(26,26,26,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#1A1A1A]">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        返回首页
    </a>

</main>

<Footer />

</body>
</html>