---
export interface Props {
    currentPage: number;
    totalPages: number;
    prevUrl: string | null;
    nextUrl: string | null;
    basePath?: string;
}

const {
    currentPage,
    totalPages,
    prevUrl,
    nextUrl,
    basePath = '/blog',
} = Astro.props;

function getPageNumbers(
    current: number,
    total: number
): (number | 'ellipsis')[] {
    if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }

    const pages: (number | 'ellipsis')[] = [1];

    if (current > 4) pages.push('ellipsis');

    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);

    for (let i = start; i <= end; i++) {
        pages.push(i);
    }

    if (current < total - 3) pages.push('ellipsis');

    pages.push(total);

    return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);

function pageUrl(page: number): string {
    return page === 1 ? basePath : `${basePath}/page/${page}`;
}
---

{totalPages > 1 && (
<nav
        class="flex items-center justify-center gap-1.5 mt-12"
        aria-label="分页导航"
>
    {prevUrl ? (
            <a
                    href={prevUrl}
                    class="px-3 py-2 text-sm border border-brand-500 text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-500/10 transition-colors"
                    aria-label="上一页"
            >
                ← 上一页
            </a>
    ) : (
            <span class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 text-gray-300 dark:text-gray-600 cursor-not-allowed">
        ← 上一页
      </span>
    )}

    {pageNumbers.map((item) => {
        if (item === 'ellipsis') {
            return (
                    <span class="px-2 py-2 text-gray-400 dark:text-gray-600 select-none">
            …
          </span>
            );
        }

        const isCurrent = item === currentPage;

        return isCurrent ? (
                <span
                        class="px-3 py-2 text-sm bg-brand-500 text-white font-medium"
                        aria-current="page"
                >
          {item}
        </span>
        ) : (
                <a
                        href={pageUrl(item)}
                        class="px-3 py-2 text-sm border border-brand-500 text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-500/10 transition-colors"
                >
                    {item}
                </a>
        );
    })}

    {nextUrl ? (
            <a
                    href={nextUrl}
                    class="px-3 py-2 text-sm border border-brand-500 text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-500/10 transition-colors"
                    aria-label="下一页"
            >
                下一页 →
            </a>
    ) : (
            <span class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 text-gray-300 dark:text-gray-600 cursor-not-allowed">
        下一页 →
      </span>
    )}
</nav>
    )}