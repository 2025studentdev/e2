---
export interface Props {
    currentPage: number;
    totalPages: number;
    prevUrl: string | null;
    nextUrl: string | null;
    basePath?: string;
}

const { currentPage, totalPages, prevUrl, nextUrl, basePath = '/blog' } = Astro.props;

function getPageNumbers(current: number, total: number): (number | 'ellipsis')[] {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

    const pages: (number | 'ellipsis')[] = [1];
    if (current > 4) pages.push('ellipsis');

    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);
    for (let i = start; i <= end; i++) pages.push(i);

    if (current < total - 3) pages.push('ellipsis');
    pages.push(total);
    return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);

function pageUrl(page: number): string {
    return page === 1 ? basePath : `${basePath}/page/${page}`;
}
---

{totalPages > 1 && (
<nav class="mt-14 flex flex-wrap items-center justify-center gap-1" aria-label="分页导航">
    {prevUrl ? (
            <a
                    href={prevUrl}
                    class="px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] hover:text-brand-500 transition-colors"
                    aria-label="上一页"
            >← 上一页</a>
    ) : (
            <span class="px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] opacity-40 cursor-not-allowed">← 上一页</span>
    )}

    {pageNumbers.map((item) => {
        if (item === 'ellipsis') {
            return <span class="px-2 py-1.5 font-mono text-sm text-[var(--fg-muted)] opacity-60 select-none">…</span>;
        }

        const isCurrent = item === currentPage;

        return isCurrent ? (
                <span
                        class="relative px-3 py-1.5 font-mono text-sm font-semibold text-brand-500"
                        aria-current="page"
                >
                {item}
                    <span aria-hidden="true" class="absolute -bottom-0.5 left-1/2 h-px w-4 -translate-x-1/2 bg-brand-500"></span>
            </span>
        ) : (
                <a
                        href={pageUrl(item)}
                        class="px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] hover:text-brand-500 transition-colors"
                >{item}</a>
        );
    })}

    {nextUrl ? (
            <a
                    href={nextUrl}
                    class="px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] hover:text-brand-500 transition-colors"
                    aria-label="下一页"
            >下一页 →</a>
    ) : (
            <span class="px-3 py-1.5 font-mono text-sm text-[var(--fg-muted)] opacity-40 cursor-not-allowed">下一页 →</span>
    )}
</nav>
    )}