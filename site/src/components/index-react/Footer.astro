---
const now = new Date();
// 中国标准时间 UTC+8（无夏令时，固定偏移）
const CST_OFFSET_MS = 8 * 60 * 60 * 1000;
const cst = new Date(now.getTime() + CST_OFFSET_MS);
const pad = (n: number) => String(n).padStart(2, '0');
// 偏移后仍用 getUTC* 读取 = 北京时间
const currentYear = cst.getUTCFullYear();
const buildTimeCST = `${cst.getUTCFullYear()}年${pad(cst.getUTCMonth() + 1)}月${pad(cst.getUTCDate())}日 ${pad(cst.getUTCHours())}:${pad(cst.getUTCMinutes())}:${pad(cst.getUTCSeconds())}`;
// 可选：机器可读的 +08:00 形式
const isoCST = cst.toISOString().replace('Z', '+08:00');
---

